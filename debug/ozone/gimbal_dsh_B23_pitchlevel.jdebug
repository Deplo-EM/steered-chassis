// Ozone 3.26+ project: 云台 B23（pitch 世界水平补偿：关节目标 - IMU 俯仰）。
// ELF: Gimbal/build/dsh-gimbal-B23-pitchlevel/steered_gimbal.elf
// SHA-256: E0545025F68FAE05E1CC53B42F609E02715F32E6FEA627A400AB056799FE2C55
// 若直行时越补越仰，说明符号反了：把 setPitchTarget(... - imu_->pitch()) 的减号改加号。
void OnProjectLoad(void) {
  Project.SetDevice("STM32F407IG");
  Project.SetHostIF("USB", "0");
  Project.SetTargetIF("SWD");
  Project.SetTIFSpeed("1 MHz");
  Project.AddSvdFile("$(InstallDir)/Config/CPU/Cortex-M4.svd");
  Project.AddSvdFile("$(InstallDir)/Config/Peripherals/STM32F407IG.svd");
  Edit.SysVar(VAR_VERIFY_DOWNLOAD, 1);
  Edit.SysVar(VAR_ALLOW_BMA_EMULATION, 0);
  Debug.SetConnectMode(CM_DOWNLOAD_RESET);
  Debug.SetResetMode(RM_SET_RESET_AND_RUN);
  File.Open("$(ProjectDir)/../../Gimbal/build/dsh-gimbal-B23-pitchlevel/steered_gimbal.elf");

  Watch.Add("robot::diag::g_gimbal_dbg");
  Watch.Add("s_robot");
  Watch.Add("uwTick");
  Watch.Add("g_reset_by_iwdg");
}
